# Server
APP_NAME=CORTEX Content Agent
APP_ENV=development
HOST=0.0.0.0
PORT=8001

# Gemini - used for campaign/content intelligence
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face - used for video generation
HF_TOKEN=hf_your_token_here
HF_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B

# Demo mode: true lets /api/content/generate work without Gemini.
# Video generation still needs HF_TOKEN.
MOCK_MODE=false

OUTPUT_DIR=outputs
